{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "awsbuilderlpu",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "awsbuilderlpu",
      "environment": "production"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "awslpu.in",
      "zone_name": "awslpu.in",
      "custom_domain": true
    },
    {
      "pattern": "www.awslpu.in",
      "zone_name": "awslpu.in",
      "custom_domain": true
    }
  ]
}